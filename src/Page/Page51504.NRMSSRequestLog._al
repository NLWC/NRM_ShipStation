page 51504 "NRM SS Request Log"
{
    Caption = 'ShipStation Request Log';
    PageType = Card;
    ApplicationArea = All;
    SourceTable = "NRM SS Request Log";
    Editable = false;

    layout
    {
        area(content)
        {
            group(Request)
            {
                Caption = 'Request';

                field("Entry No."; Rec."Entry No.")
                {
                    ApplicationArea = All;
                }
                field("Request ID"; Rec."Request ID")
                {
                    ApplicationArea = All;
                }
                field("Endpoint Code"; Rec."Endpoint Code")
                {
                    ApplicationArea = All;
                }
                field("HTTP Method"; Rec."HTTP Method")
                {
                    ApplicationArea = All;
                }
                field("Request DateTime"; Rec."Request DateTime")
                {
                    ApplicationArea = All;
                }
                field("Request URL"; Rec."Request URL")
                {
                    ApplicationArea = All;
                    ExtendedDatatype = URL;
                }
            }
            group(Response)
            {
                Caption = 'Response';

                field("Response Status Code"; Rec."Response Status Code")
                {
                    ApplicationArea = All;
                    StyleExpr = GetStatusCodeStyle();
                }
                field("Response DateTime"; Rec."Response DateTime")
                {
                    ApplicationArea = All;
                }
                field(Success; Rec.Success)
                {
                    ApplicationArea = All;
                    StyleExpr = GetSuccessStyle();
                }
                field("Duration (ms)"; Rec."Duration (ms)")
                {
                    ApplicationArea = All;
                }
                field("Error Message"; Rec."Error Message")
                {
                    ApplicationArea = All;
                    StyleExpr = 'Attention';
                    MultiLine = true;
                }
            }
            group(User)
            {
                Caption = 'User & Company';

                field("User ID"; Rec."User ID")
                {
                    ApplicationArea = All;
                }
                field("Company Name"; Rec."Company Name")
                {
                    ApplicationArea = All;
                }
            }
        }
        area(factboxes)
        {
            part("Request Headers"; "NRM SS Request Headers")
            {
                ApplicationArea = All;
                Caption = 'Request Headers';
                Provider = Rec;
                SubPageView = sorting("Entry No.");
            }
            part("Request Body"; "NRM ShipStation Request Body")
            {
                ApplicationArea = All;
                Caption = 'Request Body';
                Provider = Rec;
                SubPageView = sorting("Entry No.");
            }
            part("Response Headers"; "NRM ShipStation Response Headers")
            {
                ApplicationArea = All;
                Caption = 'Response Headers';
                Provider = Rec;
                SubPageView = sorting("Entry No.");
            }
            part("Response Body"; "NRM ShipStation Response Body")
            {
                ApplicationArea = All;
                Caption = 'Response Body';
                Provider = Rec;
                SubPageView = sorting("Entry No.");
            }
        }
    }

    actions
    {
        area(processing)
        {
            action("Open Request URL")
            {
                Caption = 'Open Request URL';
                ApplicationArea = All;
                Image = Link;
                ToolTip = 'Open the request URL in a web browser.';

                trigger OnAction()
                var
                    Hyperlink: Text;
                begin
                    if Rec."Request URL" <> '' then
                        Hyperlink.OpenInNewWindow(Rec."Request URL");
                end;
            }
