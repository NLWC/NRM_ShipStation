        }
        area(Promoted)
        {
            group(Category_Process)
            {
                Caption = 'Process';

                actionref("Open Request URL_Promoted"; "Open Request URL")
                {
                }
            }
        }
    }

    local procedure GetStatusCodeStyle(): Text
    begin
        if Rec."Response Status Code" >= 200 then
            if Rec."Response Status Code" < 300 then
                exit('Favorable')
            else if Rec."Response Status Code" < 400 then
                exit('Attention')
            else
                exit('Unfavorable');
        exit('');
    end;

    local procedure GetSuccessStyle(): Text
    begin
        if Rec.Success then
            exit('Favorable')
        else
            exit('Unfavorable');
    end;

